<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Show/filter/group by the supplier company on the "Moves Analysis"
         report (Inventory > Reporting), so stock movements can be analyzed
         by which foreign company the goods were imported from. -->
    <record id="view_move_tree_inherit_panels" model="ir.ui.view">
        <field name="name">stock.move.list.inherit.panels</field>
        <field name="model">stock.move</field>
        <field name="inherit_id" ref="stock.view_move_tree"/>
        <field name="arch" type="xml">
            <field name="product_id" position="after">
                <field name="supplier_company_id" string="الشركة المورّدة" optional="show"/>
            </field>
        </field>
    </record>

    <record id="view_move_search_inherit_panels" model="ir.ui.view">
        <field name="name">stock.move.search.inherit.panels</field>
        <field name="model">stock.move</field>
        <field name="inherit_id" ref="stock.view_move_search"/>
        <field name="arch" type="xml">
            <field name="product_id" position="after">
                <field name="supplier_company_id" string="الشركة المورّدة"/>
            </field>
            <filter name="by_product" position="after">
                <filter string="الشركة المورّدة" name="by_supplier_company" domain="[]" context="{'group_by': 'supplier_company_id'}"/>
            </filter>
        </field>
    </record>

</odoo>
