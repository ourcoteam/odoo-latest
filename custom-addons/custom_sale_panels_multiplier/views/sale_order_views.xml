<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Inherit Sale Order Form View - Add Length, Width, Thickness and number_of_panels fields -->
    <record id="view_order_form_inherit_panels" model="ir.ui.view">
        <field name="name">sale.order.form.inherit.panels</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <!-- Per-order toggle to show/hide Volume -->
            <xpath expr="//field[@name='order_line']" position="before">
                <field name="show_volume"/>
            </xpath>

            <!-- Add Length, Width, Thickness and number_of_panels fields in Form View before product_uom_qty label -->
            <xpath expr="//label[@for='product_uom_qty']" position="before">
                <!-- Thickness field -->
                <label for="thickness" string="السمك" invisible="display_type"/>
                <div name="thickness" invisible="display_type">
                    <field name="product_id" invisible="1" force_save="1"/>
                    <field name="thickness" class="oe_inline"/>
                </div>
                <!-- Width field -->
                <label for="width" string="العرض" invisible="display_type"/>
                <div name="width" invisible="display_type">
                    <field name="width" class="oe_inline"/>
                </div>
                <!-- Length field -->
                <label for="length" string="الطول" invisible="display_type"/>
                <div name="length" invisible="display_type">
                    <field name="length" class="oe_inline"/>
                </div>
                <!-- Volume (computed, readonly) -->
                <label for="volume" string="Volume" invisible="display_type or not order_id.show_volume"/>
                <div name="volume" invisible="display_type or not order_id.show_volume">
                    <field name="volume" readonly="1" class="oe_inline"/>
                </div>
                <!-- number_of_panels field -->
                <label for="number_of_panels" string="عدد الألواح" invisible="display_type"/>
                <div name="panels_qty" invisible="display_type">
                    <field name="number_of_panels" class="oe_inline"/>
                </div>
            </xpath>

            <!-- Add Length, Width, Thickness and number_of_panels fields in List View before product_uom_qty field -->
            <xpath expr="//field[@name='order_line']//list//field[@name='product_uom_qty']" position="before">
                <!-- Thickness field -->
                <field
                    name="thickness"
                    string="السمك"
                    optional="show"
                    invisible="display_type"/>
                <!-- Width field -->
                <field
                    name="width"
                    string="العرض"
                    optional="show"
                    invisible="display_type"/>
                <!-- Length field -->
                <field
                    name="length"
                    string="الطول"
                    optional="show"
                    invisible="display_type"/>
                <!-- Volume (computed, readonly) -->
                <field
                    name="volume"
                    string="Volume"
                    optional="show"
                    invisible="display_type or not parent.show_volume"
                    readonly="1"/>
                <!-- number_of_panels field -->
                <field
                    name="number_of_panels"
                    string="عدد الألواح"
                    optional="show"
                    invisible="display_type"
                    readonly="is_downpayment"/>
            </xpath>

            <!-- Make product_uom_qty readonly when dimensions and panels are used and change label to "الكمية m³" -->
            <xpath expr="//field[@name='order_line']//list//field[@name='product_uom_qty']" position="attributes">
                <attribute name="readonly">display_type or (length and width and thickness and number_of_panels and number_of_panels > 0)</attribute>
                <attribute name="string">الكمية m³</attribute>
            </xpath>

            <!-- Change product_uom_qty label in Form View to "الكمية m³" -->
            <xpath expr="//label[@for='product_uom_qty']" position="attributes">
                <attribute name="string">الكمية m³</attribute>
            </xpath>

            <!-- Change price_unit label in Form View to "سعر m³" -->
            <xpath expr="//field[@name='price_unit']" position="attributes">
                <attribute name="string">سعر m³</attribute>
            </xpath>

            <!-- Change price_unit label in List View to "سعر m³" -->
            <xpath expr="//field[@name='order_line']//list//field[@name='price_unit']" position="attributes">
                <attribute name="string">سعر m³</attribute>
            </xpath>

            <!-- Total quantity m³ in footer (like Untaxed Amount) -->
            <xpath expr="//group[@name='sale_total']/field[@name='tax_totals']" position="before">
                <div class="d-flex justify-content-between align-items-center w-100 mb-2">
                    <label class="o_form_label o_tax_total_label fw-bold" for="total_qty_m3">إجمالي الكمية m³</label>
                    <field name="total_qty_m3" nolabel="1" readonly="1" class="o_list_monetary text-end"/>
                </div>
            </xpath>
        </field>
    </record>

</odoo>
