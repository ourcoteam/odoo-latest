<?xml version="1.0" encoding="utf-8"?>
<odoo>
    
    <!-- Inherit Sale Order Form View - Add Volume and number_of_panels fields -->
    <record id="view_order_form_inherit_panels" model="ir.ui.view">
        <field name="name">sale.order.form.inherit.panels</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <!-- Add Volume and number_of_panels fields in Form View before product_uom_qty label -->
            <xpath expr="//label[@for='product_uom_qty']" position="before">
                <!-- Volume field (first) - editable -->
                <label for="volume" string="Volume" invisible="display_type"/>
                <div name="volume" invisible="display_type">
                    <field name="product_id" invisible="1" force_save="1"/>
                    <field name="volume" class="oe_inline"/>
                </div>
                <!-- number_of_panels field (second) -->
                <label for="number_of_panels" string="عدد الألواح" invisible="display_type"/>
                <div name="panels_qty" invisible="display_type">
                    <field name="number_of_panels" class="oe_inline"/>
                </div>
            </xpath>
            
            <!-- Add Volume and number_of_panels fields in List View before product_uom_qty field -->
            <xpath expr="//field[@name='order_line']//list//field[@name='product_uom_qty']" position="before">
                <!-- Volume field (first) - editable -->
                <field 
                    name="volume" 
                    string="Volume"
                    optional="show"
                    invisible="display_type"/>
                <!-- number_of_panels field (second) -->
                <field 
                    name="number_of_panels" 
                    string="عدد الألواح"
                    optional="show"
                    invisible="display_type"
                    readonly="is_downpayment"/>
            </xpath>
            
            <!-- Make product_uom_qty readonly when volume and panels are used and change label to "الكمية m³" -->
            <xpath expr="//field[@name='order_line']//list//field[@name='product_uom_qty']" position="attributes">
                <attribute name="readonly">display_type or (volume and number_of_panels and number_of_panels > 0)</attribute>
                <attribute name="string">الكمية m³</attribute>
            </xpath>
            
            <!-- Change product_uom_qty label in Form View to "الكمية m³" -->
            <xpath expr="//label[@for='product_uom_qty']" position="attributes">
                <attribute name="string">الكمية m³</attribute>
            </xpath>
            
            <!-- Change price_unit label in Form View to "سعر m³" -->
            <xpath expr="//field[@name='price_unit']" position="attributes">
                <attribute name="string">سعر m³</attribute>
            </xpath>
            
            <!-- Change price_unit label in List View to "سعر m³" -->
            <xpath expr="//field[@name='order_line']//list//field[@name='price_unit']" position="attributes">
                <attribute name="string">سعر m³</attribute>
            </xpath>
        </field>
    </record>

</odoo>
