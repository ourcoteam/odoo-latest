<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Inherit Invoice/Bill Form View - Add Width and Thickness, auto-filled from the product -->
    <record id="view_move_form_inherit_panels" model="ir.ui.view">
        <field name="name">account.move.form.inherit.panels</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='invoice_line_ids']//list//field[@name='quantity']" position="before">
                <field
                    name="thickness"
                    string="السمك"
                    optional="show"
                    invisible="display_type != 'product'"/>
                <field
                    name="width"
                    string="العرض"
                    optional="show"
                    invisible="display_type != 'product'"/>
            </xpath>
        </field>
    </record>

</odoo>
