<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_account_statement_wizard_form" model="ir.ui.view">
        <field name="name">account.statement.wizard.form</field>
        <field name="model">account.statement.wizard</field>
        <field name="arch" type="xml">
            <form string="كشف حساب">
                <field name="currency_id" invisible="1"/>
                <group>
                    <group>
                        <field name="partner_id"/>
                        <field name="company_id" groups="base.group_multi_company"/>
                    </group>
                    <group>
                        <field name="date_from"/>
                        <field name="date_to"/>
                    </group>
                </group>
                <group>
                    <group>
                        <field name="opening_balance" readonly="1"/>
                    </group>
                    <group>
                        <field name="closing_balance" readonly="1"/>
                    </group>
                </group>
                <field name="line_ids" readonly="1">
                    <list create="0" delete="0" edit="0">
                        <field name="date"/>
                        <field name="move_id"/>
                        <field name="label"/>
                        <field name="debit" sum="Total"/>
                        <field name="credit" sum="Total"/>
                        <field name="balance"/>
                        <field name="currency_id" column_invisible="1"/>
                    </list>
                </field>
                <footer>
                    <button name="action_print_pdf" string="طباعة PDF" type="object" class="btn-primary" icon="fa-print"/>
                    <button string="إغلاق" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_account_statement_wizard" model="ir.actions.act_window">
        <field name="name">كشف حساب</field>
        <field name="res_model">account.statement.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <menuitem id="menu_account_statement_wizard"
        name="كشف حساب (Statement of Account)"
        parent="account.account_reports_partners_reports_menu"
        action="action_account_statement_wizard"
        sequence="1"/>

</odoo>
