<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Sawmills: the saved values offered in the product form -->
    <record id="view_panels_product_mark_list" model="ir.ui.view">
        <field name="name">panels.product.mark.list</field>
        <field name="model">panels.product.mark</field>
        <field name="arch" type="xml">
            <list string="Sawmills" editable="bottom">
                <field name="name"/>
                <field name="product_count"/>
            </list>
        </field>
    </record>

    <!-- Only the name when creating; the product count is shown once the value exists -->
    <record id="view_panels_product_mark_form" model="ir.ui.view">
        <field name="name">panels.product.mark.form</field>
        <field name="model">panels.product.mark</field>
        <field name="arch" type="xml">
            <form string="Sawmill">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="product_count" invisible="not id"/>
                        <field name="active" invisible="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_panels_product_mark_search" model="ir.ui.view">
        <field name="name">panels.product.mark.search</field>
        <field name="model">panels.product.mark</field>
        <field name="arch" type="xml">
            <search string="Sawmills">
                <field name="name"/>
                <filter string="Archived" name="inactive" domain="[('active', '=', False)]"/>
            </search>
        </field>
    </record>

    <record id="action_panels_product_mark" model="ir.actions.act_window">
        <field name="name">Sawmills</field>
        <field name="res_model">panels.product.mark</field>
        <field name="view_mode">list</field>
        <field name="search_view_id" ref="view_panels_product_mark_search"/>
    </record>

    <!-- Grades -->
    <record id="view_panels_product_grade_list" model="ir.ui.view">
        <field name="name">panels.product.grade.list</field>
        <field name="model">panels.product.grade</field>
        <field name="arch" type="xml">
            <list string="Grades" editable="bottom">
                <field name="name"/>
                <field name="product_count"/>
            </list>
        </field>
    </record>

    <!-- Only the name when creating; the product count is shown once the value exists -->
    <record id="view_panels_product_grade_form" model="ir.ui.view">
        <field name="name">panels.product.grade.form</field>
        <field name="model">panels.product.grade</field>
        <field name="arch" type="xml">
            <form string="Grade">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="product_count" invisible="not id"/>
                        <field name="active" invisible="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_panels_product_grade_search" model="ir.ui.view">
        <field name="name">panels.product.grade.search</field>
        <field name="model">panels.product.grade</field>
        <field name="arch" type="xml">
            <search string="Grades">
                <field name="name"/>
                <filter string="Archived" name="inactive" domain="[('active', '=', False)]"/>
            </search>
        </field>
    </record>

    <record id="action_panels_product_grade" model="ir.actions.act_window">
        <field name="name">Grades</field>
        <field name="res_model">panels.product.grade</field>
        <field name="view_mode">list</field>
        <field name="search_view_id" ref="view_panels_product_grade_search"/>
    </record>

    <!-- Wood types with the supplier abbreviation (WW, RW) -->
    <record id="view_panels_product_kind_list" model="ir.ui.view">
        <field name="name">panels.product.kind.list</field>
        <field name="model">panels.product.kind</field>
        <field name="arch" type="xml">
            <list string="Wood Types" editable="bottom">
                <field name="name"/>
                <field name="code"/>
                <field name="uses_drying"/>
                <field name="uses_origin"/>
                <field name="uses_grade"/>
                <field name="uses_subtype"/>
                <field name="origin_ids" widget="many2many_tags" options="{'no_create': True}"/>
                <field name="product_count"/>
            </list>
        </field>
    </record>

    <record id="view_panels_product_kind_search" model="ir.ui.view">
        <field name="name">panels.product.kind.search</field>
        <field name="model">panels.product.kind</field>
        <field name="arch" type="xml">
            <search string="Wood Types">
                <field name="name" filter_domain="['|', ('name', 'ilike', self), ('code', 'ilike', self)]"/>
                <filter string="Archived" name="inactive" domain="[('active', '=', False)]"/>
            </search>
        </field>
    </record>

    <record id="action_panels_product_kind" model="ir.actions.act_window">
        <field name="name">Wood Types</field>
        <field name="res_model">panels.product.kind</field>
        <field name="view_mode">list</field>
        <field name="search_view_id" ref="view_panels_product_kind_search"/>
    </record>

    <!-- Origins -->
    <record id="view_panels_product_origin_list" model="ir.ui.view">
        <field name="name">panels.product.origin.list</field>
        <field name="model">panels.product.origin</field>
        <field name="arch" type="xml">
            <list string="Origins" editable="bottom">
                <field name="name"/>
                <field name="has_grades"/>
                <field name="grade_ids" widget="many2many_tags" options="{'no_create': True}" invisible="not has_grades"/>
                <field name="product_count"/>
            </list>
        </field>
    </record>

    <record id="view_panels_product_origin_search" model="ir.ui.view">
        <field name="name">panels.product.origin.search</field>
        <field name="model">panels.product.origin</field>
        <field name="arch" type="xml">
            <search string="Origins">
                <field name="name"/>
                <filter string="Archived" name="inactive" domain="[('active', '=', False)]"/>
            </search>
        </field>
    </record>

    <record id="action_panels_product_origin" model="ir.actions.act_window">
        <field name="name">Origins</field>
        <field name="res_model">panels.product.origin</field>
        <field name="view_mode">list</field>
        <field name="search_view_id" ref="view_panels_product_origin_search"/>
    </record>

    <!-- Sub-types, kept apart from the grade -->
    <record id="view_panels_product_subtype_list" model="ir.ui.view">
        <field name="name">panels.product.subtype.list</field>
        <field name="model">panels.product.subtype</field>
        <field name="arch" type="xml">
            <list string="Sub-types" editable="bottom">
                <field name="name"/>
                <field name="product_count"/>
            </list>
        </field>
    </record>

    <record id="view_panels_product_subtype_search" model="ir.ui.view">
        <field name="name">panels.product.subtype.search</field>
        <field name="model">panels.product.subtype</field>
        <field name="arch" type="xml">
            <search string="Sub-types">
                <field name="name"/>
                <filter string="Archived" name="inactive" domain="[('active', '=', False)]"/>
            </search>
        </field>
    </record>

    <record id="action_panels_product_subtype" model="ir.actions.act_window">
        <field name="name">Sub-types</field>
        <field name="res_model">panels.product.subtype</field>
        <field name="view_mode">list</field>
        <field name="search_view_id" ref="view_panels_product_subtype_search"/>
    </record>

    <!-- Inventory → Configuration → Products -->
    <menuitem id="menu_panels_product_kind_stock" action="action_panels_product_kind"
        parent="stock.menu_product_in_config_stock" sequence="8"/>
    <menuitem id="menu_panels_product_origin_stock" action="action_panels_product_origin"
        parent="stock.menu_product_in_config_stock" sequence="9"/>
    <menuitem id="menu_panels_product_mark_stock" action="action_panels_product_mark"
        parent="stock.menu_product_in_config_stock" sequence="10"/>
    <menuitem id="menu_panels_product_grade_stock" action="action_panels_product_grade"
        parent="stock.menu_product_in_config_stock" sequence="11"/>
    <menuitem id="menu_panels_product_subtype_stock" action="action_panels_product_subtype"
        parent="stock.menu_product_in_config_stock" sequence="12"/>

    <!-- Sales → Configuration → Products -->
    <menuitem id="menu_panels_product_kind_sale" action="action_panels_product_kind"
        parent="sale.prod_config_main" sequence="8"/>
    <menuitem id="menu_panels_product_origin_sale" action="action_panels_product_origin"
        parent="sale.prod_config_main" sequence="9"/>
    <menuitem id="menu_panels_product_mark_sale" action="action_panels_product_mark"
        parent="sale.prod_config_main" sequence="10"/>
    <menuitem id="menu_panels_product_grade_sale" action="action_panels_product_grade"
        parent="sale.prod_config_main" sequence="11"/>
    <menuitem id="menu_panels_product_subtype_sale" action="action_panels_product_subtype"
        parent="sale.prod_config_main" sequence="12"/>

</odoo>
