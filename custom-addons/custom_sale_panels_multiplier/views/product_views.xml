<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Inherit Product Form View - Add Width and Thickness fields -->
    <record id="view_product_template_form_inherit_dimensions" model="ir.ui.view">
        <field name="name">product.template.form.inherit.dimensions</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <!-- Add Width and Thickness in General Information tab before Internal Notes -->
            <xpath expr="//group[@name='internal_notes']" position="before">
                <group string="Dimensions" name="group_dimensions" invisible="type != 'consu'">
                    <group>
                        <!-- Pick a saved value, or type a new one and choose "Create" to save it.
                             Order = order in the product name. Each wood type only shows
                             the parts it has (spec section 2) and the origins / grades it
                             offers; an empty list in the configuration means "all". -->
                        <field name="panels_uses_drying" invisible="1"/>
                        <field name="panels_uses_origin" invisible="1"/>
                        <field name="panels_uses_grade" invisible="1"/>
                        <field name="panels_uses_subtype" invisible="1"/>
                        <field name="panels_allowed_origin_ids" invisible="1"/>
                        <field name="panels_origin_has_grades" invisible="1"/>
                        <field name="panels_allowed_grade_ids" invisible="1"/>
                        <field name="kind_id" required="type == 'consu'" options="{'no_create_edit': True, 'no_open': True}"/>
                        <field name="drying" required="type == 'consu'" widget="radio" options="{'horizontal': true}"
                               invisible="not panels_uses_drying"/>
                        <field name="origin_id" options="{'no_create_edit': True, 'no_open': True}"
                               invisible="not panels_uses_origin"
                               domain="[('id', 'in', panels_allowed_origin_ids)] if panels_allowed_origin_ids else []"/>
                        <field name="mark_id" options="{'no_create_edit': True, 'no_open': True}"/>
                        <field name="grade_id" options="{'no_create_edit': True, 'no_open': True}"
                               invisible="not panels_uses_grade or (origin_id and not panels_origin_has_grades)"
                               domain="[('id', 'in', panels_allowed_grade_ids)] if panels_allowed_grade_ids else []"/>
                        <field name="subtype_id" options="{'no_create_edit': True, 'no_open': True}"
                               invisible="not panels_uses_subtype or drying != 'ad'"/>
                        <label for="width"/>
                        <div class="o_row">
                            <field name="width" string="Width" class="oe_inline" style="max-width: 7rem;" required="type == 'consu'"/>
                        </div>
                        <label for="thickness"/>
                        <div class="o_row">
                            <field name="thickness" string="Thickness" class="oe_inline" style="max-width: 7rem;" required="type == 'consu'"/>
                        </div>
                        <field name="supplier_company_id" string="Supplier Company"/>
                    </group>
                </group>
            </xpath>

            <!-- Lock the Name field for goods: it must always be built from
                 the timber fields above so every product follows the same
                 naming pattern, with no manual exceptions. force_save: the web
                 client drops readonly fields on save otherwise, so the name
                 built on screen never reached the server. -->
            <xpath expr="//field[@name='name'][@widget='text']" position="attributes">
                <attribute name="readonly">type == 'consu'</attribute>
                <attribute name="force_save">1</attribute>
            </xpath>
        </field>
    </record>

    <!-- Make the supplier company and timber fields searchable/groupable on Inventory product lists -->
    <record id="view_product_template_search_inherit_panels" model="ir.ui.view">
        <field name="name">product.template.search.inherit.panels</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_search_view"/>
        <field name="arch" type="xml">
            <field name="product_tag_ids" position="after">
                <field name="supplier_company_id" string="Supplier Company"/>
                <field name="kind_id" filter_domain="['|', ('kind_id.name', 'ilike', self), ('kind_id.code', 'ilike', self)]"/>
                <field name="origin_id"/>
                <field name="mark_id"/>
                <field name="grade_id"/>
                <field name="subtype_id"/>
                <field name="panels_thickness_filter" string="Thickness"/>
                <field name="panels_width_filter" string="Width"/>
                <field name="panels_dimensions" string="Dimensions"/>
            </field>
            <group position="inside">
                <filter string="Supplier Company" name="group_by_supplier_company" context="{'group_by': 'supplier_company_id'}"/>
                <filter string="Wood Type" name="group_by_kind" context="{'group_by': 'kind_id'}"/>
                <filter string="Drying" name="group_by_drying" context="{'group_by': 'drying'}"/>
                <filter string="Origin" name="group_by_origin" context="{'group_by': 'origin_id'}"/>
                <filter string="Sawmill" name="group_by_mark" context="{'group_by': 'mark_id'}"/>
                <filter string="Grade" name="group_by_grade" context="{'group_by': 'grade_id'}"/>
                <filter string="Sub-type" name="group_by_subtype" context="{'group_by': 'subtype_id'}"/>
                <filter string="Thickness" name="group_by_thickness" context="{'group_by': 'panels_thickness_filter'}"/>
                <filter string="Width" name="group_by_width" context="{'group_by': 'panels_width_filter'}"/>
                <filter string="Dimensions (Thickness × Width)" name="group_by_dimensions" context="{'group_by': 'panels_dimensions'}"/>
            </group>
            <!-- Timber filters sidebar: tick any mix of values; values within a
                 section are OR-ed, sections are AND-ed, counts follow the
                 other active filters. -->
            <xpath expr="/search" position="inside">
                <searchpanel>
                    <field name="kind_id" string="Wood Type" select="multi" enable_counters="1" icon="fa-tree"/>
                    <field name="drying" string="Drying" select="multi" enable_counters="1" icon="fa-tint"/>
                    <field name="origin_id" string="Origin" select="multi" enable_counters="1" icon="fa-globe"/>
                    <field name="mark_id" string="Sawmill" select="multi" enable_counters="1" icon="fa-scissors"/>
                    <field name="grade_id" string="Grade" select="multi" enable_counters="1" icon="fa-certificate"/>
                    <field name="subtype_id" string="Sub-type" select="multi" enable_counters="1" icon="fa-tag"/>
                    <field name="panels_thickness_filter" string="Thickness" select="multi" enable_counters="1" icon="fa-arrows-v"/>
                    <field name="panels_width_filter" string="Width" select="multi" enable_counters="1" icon="fa-arrows-h"/>
                    <field name="supplier_company_id" string="Supplier Company" select="multi" enable_counters="1" icon="fa-building"/>
                </searchpanel>
            </xpath>
        </field>
    </record>

    <!-- The search view above is also the base of the variant (product.product)
         search views: drop the sidebar there (expense categories, variants),
         and the stock report gets the sections in its own sidebar instead,
         since two search panels in one view break each other. -->
    <record id="view_product_product_search_no_panels_sidebar" model="ir.ui.view">
        <field name="name">product.product.search.no.panels.sidebar</field>
        <field name="model">product.product</field>
        <field name="inherit_id" ref="product.product_search_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//searchpanel[field[@name='panels_thickness_filter']]" position="replace"/>
        </field>
    </record>

    <record id="view_product_stock_report_search_panels" model="ir.ui.view">
        <field name="name">product.product.search.stock.report.panels</field>
        <field name="model">product.product</field>
        <field name="inherit_id" ref="stock.product_search_form_view_stock_report"/>
        <field name="arch" type="xml">
            <xpath expr="//searchpanel/field[@name='categ_id']" position="after">
                <field name="kind_id" string="Wood Type" select="multi" enable_counters="1" icon="fa-tree"/>
                <field name="drying" string="Drying" select="multi" enable_counters="1" icon="fa-tint"/>
                <field name="origin_id" string="Origin" select="multi" enable_counters="1" icon="fa-globe"/>
                <field name="mark_id" string="Sawmill" select="multi" enable_counters="1" icon="fa-scissors"/>
                <field name="grade_id" string="Grade" select="multi" enable_counters="1" icon="fa-certificate"/>
                <field name="subtype_id" string="Sub-type" select="multi" enable_counters="1" icon="fa-tag"/>
                <field name="panels_thickness_filter" string="Thickness" select="multi" enable_counters="1" icon="fa-arrows-v"/>
                <field name="panels_width_filter" string="Width" select="multi" enable_counters="1" icon="fa-arrows-h"/>
                <field name="supplier_company_id" string="Supplier Company" select="multi" enable_counters="1" icon="fa-building"/>
            </xpath>
        </field>
    </record>

    <!-- Timber columns in the products list (sortable, can be hidden) -->
    <record id="view_product_template_list_inherit_panels" model="ir.ui.view">
        <field name="name">product.template.list.inherit.panels</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_tree_view"/>
        <field name="arch" type="xml">
            <field name="default_code" position="after">
                <field name="kind_id" optional="show" options="{'no_create_edit': True, 'no_open': True}"/>
                <field name="drying" optional="show"/>
                <field name="origin_id" optional="show" options="{'no_create_edit': True, 'no_open': True}"/>
                <field name="mark_id" optional="show" options="{'no_create_edit': True, 'no_open': True}"/>
                <field name="grade_id" optional="show" options="{'no_create_edit': True, 'no_open': True}"/>
                <field name="subtype_id" optional="hide" options="{'no_create_edit': True, 'no_open': True}"/>
                <field name="thickness" optional="show"/>
                <field name="width" optional="show"/>
                <field name="supplier_company_id" string="Supplier Company" optional="hide"/>
            </field>
        </field>
    </record>

</odoo>
